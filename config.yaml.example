llm:
  provider: dashscope
  api_key: ${DASHSCOPE_API_KEY:-your-api-key-here}
  model: qwen3.5-plus
  base_url: https://dashscope.aliyuncs.com
  max_tokens: 0                     # 0 表示使用模型默认值
  temperature: 0.7
  timeout: 60000
  # 思考模式（适用于 DeepSeek R1 等推理模型）
  thinking_enabled: true            # 是否启用思考模式（仅对支持思考模式的模型有效）
  reasoning_effort: high            # 思考强度：high（默认）/ max
  response_format:                  # 响应格式（可选）：text / json_object
  # 模型历史快照（自动维护，保存切换过的模型配置，用于快速切换）
  model_history: []

# 外部运行时路径配置（可选）
# 当系统 PATH 不完整时，可通过这里指定可执行文件路径。
# 配置后会自动将所在目录追加到子进程 PATH 环境变量前面。
runtimes:
  # node: "C:/Program Files/nodejs/node.exe"    # Windows
  # node: /usr/local/bin/node                    # macOS / Linux
  # python: "C:/Python312/python.exe"
  # python: /usr/bin/python3
  # go: "C:/Go/bin/go.exe"
  # go: /usr/local/go/bin/go

tools:
  bash:
    enabled: true
    whitelist:
      - git
      - mvn
      - npm
      - docker
      - ls
      - cat
      - grep
      - find
    require_confirmation: true
  file:
    enabled: true
    allowed_paths:
      - .
    max_file_size: 10MB
    blocked_extensions:
      - .env
      - .pem
      - .key
      - .p12
      - .jks
  web_search:
    provider: brave               # brave | tavily
    api_key: "your-api-key"
    # Brave Search 免费注册: https://brave.com/search/api/（月 2,000 次）
    # Tavily 免费注册: https://tavily.com/（月 1,000 basic + 100 advanced）
  subagent:
    # Sub-Agent 并行任务（默认关闭）
    # 启用后注册 fork_agent / fork_agents / list_subagents / cancel_subagent 工具
    enabled: false

session:
  auto_save: true
  max_history: 50
  history_file: ".hippo/cli-history"   # CLI 历史记录文件路径
  save_directory:                      # 会话保存目录（可选，不设置则使用默认）
  persist_sessions: true               # 是否持久化会话到磁盘
  max_saved_sessions: 1000             # 最大保存会话数
  auto_resume: true                    # 启动时自动检查可恢复会话
  resume_timeout_hours: 72             # 超过此时间的会话自动标记为 IGNORED
  enable_background_cleanup: true      # 启用后台清理
  cleanup_period_days: 30              # 清理周期（天）
  tombstone_threshold_mb: 50           # 墓碑文件阈值（超过此大小触发清理）

ui:
  theme: dark
  prompt: "agent>"
  syntax_highlight: true
  show_token_usage: true
  show_timestamp: false
  color_output: true

web:
  port: 9090

context:
  max_tokens: 30000

rule:
  # 规则文件从 .hippo/rules/*.md 加载
  max_tokens: 8000                    # Rule 最大 token 数
  inject_at_startup: true             # 启动时注入

tokenizer:
  type: tiktoken                      # tiktoken / simple
  cache_enabled: true                 # 缓存开关
  cache_max_size: 1000                # 缓存最大条目数

memory:
  # 长期记忆提取配置
  # 系统会定期从对话中提取重要信息作为长期记忆保存
  extraction_enabled: false           # 启用长期记忆提取（默认关闭）
  extraction_interval: 5              # 每 N 轮对话触发一次提取
  session_extraction_enabled: true    # 启用会话内记忆提取（默认开启）

mcp:
  # MCP（Model Context Protocol）服务配置
  enabled: true                       # 全局启用 MCP
  auto_connect: true                  # 启动时自动连接
  auto_reconnect: true                # 断开时自动重连
  max_reconnect_attempts: 5           # 最大重连次数
  reconnect_delay_seconds: 5          # 重连间隔（秒）
  connection_timeout: 30000           # 连接超时（毫秒）
  request_timeout: 60000              # 请求超时（毫秒）
  servers: []                         # MCP 服务列表（在 config.yaml 中配置）
  # servers:
  #   - id: my-server
  #     name: My MCP Server
  #     type: stdio                    # stdio | sse
  #     command: npx
  #     args: ["-y", "@modelcontextprotocol/server-filesystem", "."]
  #     env:
  #       MY_VAR: value

lsp:
  # LSP 语言服务器配置（高级代码理解能力：跳转到定义、查找引用等）
  enabled: true                       # 全局启用 LSP 功能
  timeout: 180                        # LSP 请求超时（秒）
  servers:                            # 按语言 ID 配置服务器
    # java:
    #   enabled: true
    #   command: jdtls
    #   args:
    #     - "-configuration"
    #     - "${user_home}/.jdtls/config"
    #     - "-data"
    #     - "${user_home}/.jdtls/workspace"
    #   env:
    #     JAVA_HOME: /path/to/jdk-17+

workspace:
  default_workspace_path: ""          # 默认工作区路径（桌面端通过 UI 设置）
